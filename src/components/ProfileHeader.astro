---
import SocialLinks from "./SocialLinks.astro";
import { resizedImageSrc } from "../utils/resized-image";
import type { FeedType } from "../utils/timeline";
import { getLang, localizePath, ui } from "../utils/i18n";

/**
 * Top of the timeline card: cover band, profile photo, site title and
 * tagline, post/work counts, and the すべて / ブログ / Bluesky / 作ったもの
 * tabs. The tabs are links to /, /posts, /bluesky and /works (under /en in
 * English), so each view has its own URL.
 */
interface Props {
	name: string;
	tagline?: string | null;
	photo?: string | null;
	profileUrl: string | null;
	postCount: number;
	workCount: number;
	active: FeedType;
	/** The Bluesky tab appears once there are posts to show. */
	showBluesky: boolean;
}

const { name, tagline, photo, profileUrl, postCount, workCount, active, showBluesky } =
	Astro.props;

const photoSrc = photo ? await resizedImageSrc(photo, 104, Astro.url.origin) : null;

const lang = getLang(Astro);
const t = ui[lang];

const tabs: Array<{ type: FeedType; label: string; href: string }> = [
	{ type: "all", label: t.tabAll, href: localizePath("/", lang) },
	{ type: "posts", label: t.tabPosts, href: localizePath("/posts", lang) },
	...(showBluesky
		? [{ type: "bluesky" as const, label: t.tabBluesky, href: localizePath("/bluesky", lang) }]
		: []),
	{ type: "works", label: t.tabWorks, href: localizePath("/works", lang) },
];
---

<header class="profile">
	<div class="profile__cover" aria-hidden="true">
		<span class="profile__dot profile__dot--1"></span>
		<span class="profile__dot profile__dot--2"></span>
	</div>
	<div class="profile__body">
		<div class="profile__top">
			{
				photoSrc ? (
					<img src={photoSrc} alt="" class="profile__photo" width="104" height="104" />
				) : (
					<span class="profile__photo profile__photo--empty" aria-hidden="true">
						{[...name.trim()][0]?.toUpperCase()}
					</span>
				)
			}
			{profileUrl && <a href={profileUrl} class="pill-btn pill-btn--ghost">{t.profile}</a>}
		</div>
		<h1 class="profile__name">{name}</h1>
		{tagline && <p class="profile__tagline">{tagline}</p>}
		<p class="profile__stats">
			<span><b>{postCount}</b> {t.postCount}</span>
			<span><b>{workCount}</b> {t.workCount}</span>
		</p>
		<SocialLinks class="profile__social" />
	</div>
	<nav class="tabs" aria-label={t.tabsLabel}>
		{
			tabs.map((tab) => (
				<a
					href={tab.href}
					class="tabs__tab"
					aria-current={tab.type === active ? "page" : undefined}
				>
					{tab.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.profile__cover {
		position: relative;
		height: 180px;
		overflow: hidden;
		background: var(--color-cover);
	}

	.profile__dot {
		position: absolute;
		border-radius: 50%;
	}

	.profile__dot--1 {
		width: 260px;
		height: 260px;
		top: -90px;
		right: -40px;
		background: var(--color-cover-dot-1);
	}

	.profile__dot--2 {
		width: 140px;
		height: 140px;
		right: 200px;
		bottom: -60px;
		background: var(--color-cover-dot-2);
	}

	.profile__body {
		padding: 0 24px 20px;
	}

	.profile__top {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 12px;
		margin-top: -48px;
	}

	.profile__photo {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 104px;
		height: 104px;
		border: 5px solid var(--color-surface);
		border-radius: 50%;
		object-fit: cover;
		background: var(--color-photo);
	}

	.profile__photo--empty {
		color: var(--color-text-secondary);
		font-size: 40px;
		font-weight: 700;
	}

	.profile__name {
		margin-top: 12px;
		font-size: 26px;
		line-height: 1.4;
	}

	.profile__tagline {
		margin-top: 6px;
		color: var(--color-text-secondary);
	}

	.profile__stats {
		display: flex;
		gap: 20px;
		margin-top: 12px;
		font-size: 14px;
		color: var(--color-muted);
	}

	.profile__stats b {
		color: var(--color-text);
	}

	.profile__body :global(.profile__social) {
		margin-top: 14px;
	}

	.tabs {
		display: flex;
		border-bottom: 1px solid var(--color-border);
		/* Safety net for very narrow screens: scroll instead of wrapping */
		overflow-x: auto;
		scrollbar-width: none;
	}

	.tabs__tab {
		flex: 1 1 auto;
		padding: 16px 8px 13px;
		white-space: nowrap;
		border-bottom: 3px solid transparent;
		color: var(--color-muted);
		font-size: 15px;
		font-weight: 700;
		text-align: center;
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background-color var(--transition-fast);
	}

	.tabs__tab:hover {
		background: var(--color-fill);
		color: var(--color-text);
	}

	.tabs__tab[aria-current="page"] {
		border-bottom-color: var(--color-accent);
		color: var(--color-text);
	}

	@media (max-width: 560px) {
		.profile__cover {
			height: 140px;
		}

		.profile__body {
			padding-inline: 16px;
		}

		.tabs__tab {
			padding-inline: 6px;
			font-size: 14px;
		}
	}
</style>
