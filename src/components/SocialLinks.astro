---
import { getLang } from "../utils/i18n";
import { getLocalizedMenu } from "../utils/menus";

/**
 * Round icon links for the site owner's accounts, read from the "social"
 * menu (管理画面 > メニュー). The icon is picked from each link's URL; the
 * item label becomes the accessible name. Renders nothing when the menu
 * is missing or empty.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const { items, cacheHints } = await getLocalizedMenu("social", getLang(Astro));
if (Astro.cache?.enabled) {
	for (const hint of cacheHints) Astro.cache.set(hint);
}

type Icon = "bluesky" | "x" | "github" | "instagram" | "youtube" | "mail" | "link";

function iconFor(url: string): Icon {
	if (url.startsWith("mailto:")) return "mail";
	let host: string;
	try {
		host = new URL(url).hostname.replace(/^www\./, "");
	} catch {
		return "link";
	}
	if (host === "bsky.app" || host.endsWith(".bsky.social")) return "bluesky";
	if (host === "x.com" || host === "twitter.com") return "x";
	if (host === "github.com") return "github";
	if (host === "instagram.com") return "instagram";
	if (host === "youtube.com" || host === "youtu.be") return "youtube";
	return "link";
}

const links = items.map((item) => ({
	label: item.label,
	url: item.url,
	icon: iconFor(item.url),
	external: !item.url.startsWith("/") && !item.url.startsWith("mailto:"),
}));
---

{
	links.length > 0 && (
		<ul class:list={["social", className]} aria-label="SNS">
			{links.map((link) => (
				<li>
					<a
						href={link.url}
						class="social__link"
						aria-label={link.label}
						title={link.label}
						target={link.external ? "_blank" : undefined}
						rel={link.external ? "me noopener noreferrer" : undefined}
					>
						{link.icon === "bluesky" && (
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z" />
							</svg>
						)}
						{link.icon === "x" && (
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" />
							</svg>
						)}
						{link.icon === "github" && (
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
							</svg>
						)}
						{link.icon === "instagram" && (
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<rect x="3" y="3" width="18" height="18" rx="5" />
								<circle cx="12" cy="12" r="4" />
								<path d="M17.5 6.5h.01" />
							</svg>
						)}
						{link.icon === "youtube" && (
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
							</svg>
						)}
						{link.icon === "mail" && (
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<rect x="3" y="5" width="18" height="14" rx="3" />
								<path d="m4 7 8 6 8-6" />
							</svg>
						)}
						{link.icon === "link" && (
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
								<path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
							</svg>
						)}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.social {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
	}

	.social__link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--color-fill);
		color: var(--color-text);
		text-decoration: none;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast);
	}

	.social__link:hover {
		background: var(--color-fill-strong);
		color: var(--color-brand);
	}

	.social__link svg {
		width: 20px;
		height: 20px;
	}
</style>
