---
import { getLang, ui } from "../utils/i18n";

/**
 * Heart button for the site-likes plugin. Anyone can press it, no login.
 * The browser remembers what it liked (localStorage) and shows the heart
 * filled; pressing again takes the like back. The count is never shown:
 * it's in the admin under Likes.
 *
 * icon: a round 44px icon button, for timeline rows.
 * small: a 32px icon button, for the Bluesky bubbles.
 * pill: a labelled pill button, for the article footer.
 */
interface Props {
	collection: string;
	id: string;
	title: string;
	variant?: "icon" | "small" | "pill";
}

const { collection, id, title, variant = "icon" } = Astro.props;
const t = ui[getLang(Astro)];
---

<button
	type="button"
	class:list={["like-btn", `like-btn--${variant}`]}
	data-like={`${collection}:${id}`}
	aria-pressed="false"
	aria-label={variant === "pill" ? undefined : t.likeTitle(title)}
>
	<svg
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
		><path
			d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
		></path></svg
	>
	{variant === "pill" && t.like}
</button>

<script>
	const STORAGE_KEY = "site-likes";
	const ENDPOINT = "/_emdash/api/plugins/site-likes/like";

	/** Keys ("posts:01ABC…") this browser has liked. Empty if storage is blocked. */
	function readLiked(): Set<string> {
		try {
			const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
			return new Set(Array.isArray(saved) ? saved : []);
		} catch {
			return new Set();
		}
	}

	function saveLiked(liked: Set<string>) {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify([...liked]));
		} catch {
			// Private mode or blocked storage: the heart still works for this page.
		}
	}

	function show(key: string, pressed: boolean) {
		for (const button of document.querySelectorAll<HTMLButtonElement>(
			`.like-btn[data-like="${CSS.escape(key)}"]`,
		)) {
			button.setAttribute("aria-pressed", String(pressed));
		}
	}

	const liked = readLiked();
	for (const key of liked) show(key, true);

	document.addEventListener("click", (event) => {
		const button = (event.target as Element | null)?.closest<HTMLButtonElement>(".like-btn");
		const key = button?.dataset.like;
		if (!button || !key) return;
		event.preventDefault();

		const [collection, id] = key.split(":");
		const pressing = button.getAttribute("aria-pressed") !== "true";
		if (pressing) liked.add(key);
		else liked.delete(key);
		saveLiked(liked);
		show(key, pressing);

		// Fire and forget: the visitor sees the heart change either way.
		fetch(ENDPOINT, {
			method: "POST",
			headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
			body: JSON.stringify({ collection, id, action: pressing ? "like" : "unlike" }),
			keepalive: true,
		}).catch(() => {});
	});
</script>

<style>
	.like-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		border: 0;
		color: var(--color-muted);
		font: inherit;
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast);
	}

	.like-btn svg {
		width: 18px;
		height: 18px;
		flex: none;
		transition: transform var(--transition-fast);
	}

	.like-btn:hover {
		color: var(--color-brand);
	}

	.like-btn[aria-pressed="true"] {
		color: var(--color-brand);
	}

	.like-btn[aria-pressed="true"] svg {
		fill: currentColor;
	}

	.like-btn:active svg {
		transform: scale(0.85);
	}

	.like-btn--icon,
	.like-btn--small {
		padding: 0;
		border-radius: 50%;
		background: transparent;
	}

	.like-btn--icon {
		width: 44px;
		height: 44px;
	}

	.like-btn--icon:hover,
	.like-btn--small:hover {
		background: var(--color-fill);
	}

	.like-btn--small {
		width: 32px;
		height: 32px;
	}

	.like-btn--small svg {
		width: 16px;
		height: 16px;
	}

	.like-btn--pill {
		min-height: 44px;
		padding: 10px 18px;
		border-radius: var(--radius-full);
		background: var(--color-fill);
		color: var(--color-text);
		font-size: 14px;
		font-weight: 700;
	}

	.like-btn--pill:hover {
		background: var(--color-fill-strong);
	}

	.like-btn--pill[aria-pressed="true"] {
		color: var(--color-brand);
	}
</style>
