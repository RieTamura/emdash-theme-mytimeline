---
import { getLang, ui } from "../utils/i18n";

/**
 * A Bluesky post's own like count, shown as "🦋 12". Read-only: liking
 * happens on Bluesky. The page is cached, so the browser fetches the
 * current counts from Bluesky's public API after load; until then, or if
 * that fails, nothing shows.
 */
interface Props {
	uri: string;
}

const { uri } = Astro.props;
const t = ui[getLang(Astro)];
---

<span class="bsky-likes" data-bsky-likes={uri} hidden>
	<span class="sr-only">{t.blueskyLikes}</span>
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<path
			d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"
		></path>
	</svg>
	<span class="bsky-likes__count"></span>
</span>

<script>
	const API = "https://public.api.bsky.app/xrpc/app.bsky.feed.getPosts";
	/** getPosts takes at most 25 URIs per request. */
	const BATCH = 25;

	async function fill() {
		const badges = [...document.querySelectorAll<HTMLElement>("[data-bsky-likes]")];
		const uris = [...new Set(badges.map((badge) => badge.dataset.bskyLikes!))];
		const counts = new Map<string, number>();

		for (let i = 0; i < uris.length; i += BATCH) {
			const params = new URLSearchParams();
			for (const uri of uris.slice(i, i + BATCH)) params.append("uris", uri);
			try {
				const response = await fetch(`${API}?${params}`);
				if (!response.ok) continue;
				const { posts } = (await response.json()) as {
					posts?: Array<{ uri: string; likeCount?: number }>;
				};
				for (const post of posts ?? []) counts.set(post.uri, post.likeCount ?? 0);
			} catch {
				// Offline or blocked: leave the counts hidden.
			}
		}

		for (const badge of badges) {
			const count = counts.get(badge.dataset.bskyLikes!);
			if (count === undefined) continue;
			badge.querySelector(".bsky-likes__count")!.textContent = String(count);
			badge.hidden = false;
		}
	}

	fill();
</script>

<style>
	.bsky-likes {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: var(--color-muted);
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}

	.bsky-likes[hidden] {
		display: none;
	}

	.bsky-likes svg {
		width: 14px;
		height: 14px;
		color: #1185fe;
	}
</style>
